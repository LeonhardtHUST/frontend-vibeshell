{
  "name": "@hustradio/dev-shell",
  "version": "0.1.0",
  "description": "A local development workbench for browser context, coding agents and MCP collaboration",
  "type": "module",
  "license": "MIT",
  "author": "HUSTRadio",
  "repository": {"type": "git", "url": "https://github.com/HUSTRadio/dev-shell.git"},
  "homepage": "https://github.com/HUSTRadio/dev-shell#readme",
  "bugs": {"url": "https://github.com/HUSTRadio/dev-shell/issues"},
  "bin": {"dev-shell": "dist/server/cli.js"},
  "files": ["dist", "LICENSE", "THIRD_PARTY_NOTICES.md", "SOURCE.md"],
  "engines": {"node": ">=22.13"},
  "devEngines": {"packageManager": {"name": "pnpm", "version": "11.20.0", "onFail": "download"}},
  "publishConfig": {"access": "public"},
  "scripts": {
    "dev": "concurrently -k -n web,server \"pnpm --filter @hustradio/dev-shell-web dev\" \"pnpm --filter @hustradio/dev-shell-server dev\"",
    "start": "node dist/server/cli.js",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "test": "node scripts/check.mjs test",
    "test:e2e": "playwright test -c packages/dev-shell/playwright.config.ts",
    "test:package": "node scripts/test-package.mjs",
    "smoke:agents": "node dist/server/cli.js smoke:agents",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "parse5": "^8.0.0",
    "proper-lockfile": "4.1.2",
    "tough-cookie": "6.0.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hustradio/unitary-ui": "0.1.0-beta.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
